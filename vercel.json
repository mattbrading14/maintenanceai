{
  "functions": {
    "api/claude.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/site.js": {
      "memory": 512,
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/favicon.ico",
      "dest": "/assets/maintenanceai-mark.svg"
    },
    {
      "src": "/$",
      "dest": "/api/site.js"
    },
    {
      "src": "/maintenanceai-website-v2.html$",
      "dest": "/api/site.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
