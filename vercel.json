{
  "functions": {
    "api/claude.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/app.js": {
      "memory": 512,
      "maxDuration": 10
    },
    "api/site.js": {
      "memory": 512,
      "maxDuration": 10
    },
    "api/supabase-keepalive.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/supabase-keepalive",
      "schedule": "0 16 * * *"
    }
  ],
  "routes": [
    {
      "src": "/favicon.ico",
      "dest": "/assets/maintenanceai-mark.svg"
    },
    {
      "src": "/$",
      "dest": "/api/app.js?mode=personal"
    },
    {
      "src": "/146-main$",
      "dest": "/api/app.js?mode=personal"
    },
    {
      "src": "/public-app$",
      "dest": "/api/app.js?mode=public"
    },
    {
      "src": "/demo-app$",
      "dest": "/api/app.js?mode=public"
    },
    {
      "src": "/maintenanceai-website-v2.html$",
      "dest": "/api/site.js"
    },
    {
      "src": "/website$",
      "dest": "/api/site.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
